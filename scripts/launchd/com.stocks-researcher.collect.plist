<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 템플릿: install.sh 가 __REPO__ 등을 채워 ~/Library/LaunchAgents 에 복사한다. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stocks-researcher.collect</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NPM__</string>
        <string>run</string>
        <string>collect</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>
    <!-- 매일 08:30. Mac 이 잠자기 중이었다면 깨어난 직후 한 번 실행된다. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/collect.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/collect.err.log</string>
</dict>
</plist>
